<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- No network permission or production components are included in the preview. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <application android:name="android.app.Application" android:allowBackup="false"
        android:label="KOne Visual" android:theme="@style/AppTheme" android:supportsRtl="true">
        <provider tools:node="removeAll" />
        <service tools:node="removeAll" />
        <receiver tools:node="removeAll" />
        <activity android:name="io.nekohasekai.sfa.preview.VisualPreviewActivity"
            android:exported="true" android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
