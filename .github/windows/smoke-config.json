{
  "log": { "level": "warn" },
  "dns": {
    "servers": [{ "type": "local", "tag": "local" }],
    "rules": [
      { "domain_suffix": ["anthropic.com", "claude.ai", "claude.com", "claudeusercontent.com"], "action": "reject" }
    ]
  },
  "inbounds": [
    { "type": "tun", "tag": "tun-in", "interface_name": "KOne", "address": ["172.19.0.1/30"], "auto_route": true, "strict_route": true }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": {
    "rules": [
      { "action": "sniff" },
      { "domain_suffix": ["anthropic.com", "claude.ai", "claude.com", "claudeusercontent.com"], "action": "reject" }
    ],
    "final": "direct",
    "auto_detect_interface": true
  }
}
